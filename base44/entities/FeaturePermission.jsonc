{
  "name": "FeaturePermission",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "group": {
      "type": "string"
    },
    "allowed_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "user",
          "admin",
          "super_admin",
          "public"
        ]
      }
    },
    "view_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "user",
          "admin",
          "super_admin",
          "public"
        ]
      }
    },
    "edit_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "user",
          "admin",
          "super_admin",
          "public"
        ]
      }
    },
    "delete_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "user",
          "admin",
          "super_admin",
          "public"
        ]
      }
    }
  },
  "required": [
    "key",
    "label",
    "allowed_roles"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}