{
  "name": "Production",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "plan_date": {
      "type": "string",
      "format": "date"
    },
    "item_name": {
      "type": "string"
    },
    "planned_quantity": {
      "type": "number",
      "minimum": 0
    },
    "unit": {
      "type": "string"
    },
    "warehouse": {
      "type": "string",
      "default": "Gudang Jakarta"
    },
    "note": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "menunggu_proses",
        "selesai"
      ],
      "default": "menunggu_proses"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "by": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "plan_date",
    "item_name",
    "planned_quantity",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}